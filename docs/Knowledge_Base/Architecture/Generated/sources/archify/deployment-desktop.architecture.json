  "meta": {
    "title": "Deployment Diagram \u2014 Desktop Runtime",
    "subtitle": "[DESKTOP-PROPOSED] Single desktop process, webview frontend, Go runtime, local storage, shared Supabase. Nothing is deployed yet.",
