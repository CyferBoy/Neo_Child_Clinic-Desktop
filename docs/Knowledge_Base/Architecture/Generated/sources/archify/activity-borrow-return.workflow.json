      "label": "none fit",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "n5",
      "from": "cap",
      "to": "over",
      "label": "exceeds",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    }
  ],
  "schema_version": 1
